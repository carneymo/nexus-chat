# Run pnpm setup to create a local .env with a generated secret.
REGISTRATION_ALLOWED=true
# Registration starts closed in the database. Open after reviewing members.
# Direct local development trusts no proxy. Compose sets Caddy's exact address.
TRUSTED_PROXY_IPS=
SERVER_NAME=Nexus
APP_ORIGIN=http://127.0.0.1:3000
HOST=127.0.0.1
PORT=3001
DATA_DIR=./data
STATIC_DIR=./dist/client
# Docker Compose also reads DOMAIN, used by Caddy for HTTPS:
DOMAIN=chat.example.com
# Voice relay (configured by scripts/setup-turn.sh on Lightsail)
TURN_URLS=
TURN_SECRET=

# Browser-visible GIPHY API key; optional GIF search integration
GIPHY_API_KEY=
